{
    "name": "sonatacss",
    "version": "0.4.0-beta.2",
    "description": "A traditional CSS framework and UI toolkit with modern features and on-demand styles.",
    "keywords": [
        "css",
        "framework",
        "responsive",
        "ui",
        "front-end",
        "components",
        "on-demand",
        "unocss"
    ],
    "homepage": "https://github.com/alexcandelas/sonata",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alexcandelas/sonata.git"
    },
    "bugs": {
        "url": "https://github.com/alexcandelas/sonata/issues"
    },
    "license": "MIT",
    "author": "Alex Candelas <axcandelas@gmail.com>",
    "main": "index.js",
    "exports": {
        ".": {
            "import": "./index.js"
        },
        "./abstractions/*.css": "./src/css/abstractions/*.css",
        "./abstractions/*.js": "./src/css/abstractions/*.js",
        "./base/*.css": "./src/css/base/*.css",
        "./components/*.css": "./src/css/components/*.css",
        "./components/*.js": "./src/css/components/*.js",
        "./utilities/*.css": "./src/css/utilities/*.css",
        "./utilities/*.js": "./src/css/utilities/*.js",
        "./generated-styles.css": "./src/css/generated-styles.css",
        "./print.css": "./src/css/print.css",
        "./icons/*.svg": "./src/icons/*.svg",
        "./lengthUnits": "./src/config/lengthUnits.js",
        "./lengthUnits.js": "./src/config/lengthUnits.js",
        "./palette": "./src/config/palette.js",
        "./palette.js": "./src/config/palette.js",
        "./utils": "./src/utils/index.js"
    },
    "type": "module",
    "scripts": {
        "test": "vitest"
    },
    "devDependencies": {
        "vitest": "^2.1.4"
    },
    "dependencies": {
        "browserslist": "^4.24.4",
        "browserslist-to-esbuild": "^2.1.1",
        "fast-glob": "3.3.3",
        "lightningcss": "1.30.1",
        "micromatch": "4.0.8",
        "unocss": "66.5.2"
    },
    "peerDependencies": {
        "vite": "^5.4.0 || ^6 || ^7"
    },
    "files": [
        "src/",
        "index.js"
    ]
}
