{
    "name": "sonatacss",
    "version": "1.0.0-beta.2",
    "description": "A responsive CSS framework with native CSS cascade layers and on-demand utility classes.",
    "keywords": [
        "css",
        "framework",
        "responsive",
        "mobile-first",
        "ui",
        "front-end"
    ],
    "homepage": "https://github.com/alexcandelas/sonata",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alexcandelas/sonata.git"
    },
    "bugs": {
        "url": "https://github.com/alexcandelas/sonata/issues"
    },
    "license": "MIT",
    "author": "Alex Candelas <axcandelas@gmail.com>",
    "main": "index.js",
    "exports": {
        ".": {
            "import": "./index.js"
        },
        "./abstractions/*.css": "./css/abstractions/*.css",
        "./base/*.css": "./css/base/*.css",
        "./components/*.css": "./css/components/*.css",
        "./utilities/*.css": "./css/utilities/*.css",
        "./generated-styles.css": "./css/generated-styles.css",
        "./print.css": "./css/print.css",
        "./icons/*.svg": "./src/icons/*.svg",
        "./palette": "./src/config/palette.js",
        "./palette.js": "./src/config/palette.js",
        "./utils": "./src/utils/index.js"
    },
    "type": "module",
    "scripts": {
        "test": "vitest"
    },
    "devDependencies": {
        "vitest": "^2.1.4"
    },
    "dependencies": {
        "browserslist": "^4.24.4",
        "browserslist-to-esbuild": "^2.1.1",
        "fast-glob": "3.3.3",
        "lightningcss": "1.30.1",
        "micromatch": "4.0.8",
        "unocss": "66.5.2",
        "unocss-preset-sonatacss": "^1.0.0-beta.3"
    },
    "peerDependencies": {
        "vite": "^5.4.0 || ^6 || ^7"
    },
    "files": [
        "css/",
        "src/",
        "index.js"
    ]
}
